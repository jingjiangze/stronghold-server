[Unit]
Description=Stronghold baidu sync (pull + safe apply)
# 拉取 GitHub 走本机 mihomo，所以排在它后面
After=network-online.target mihomo.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/stronghold/deploy/baidu/sync.sh
# 日志进 journal：journalctl -t stronghold-sync
SyslogIdentifier=stronghold-sync
# 30 分钟一轮，单轮超时给足（npm ci + 重启 + 回滚）
TimeoutStartSec=900

# 由 stronghold-sync.timer 定时驱动（见 deploy/baidu/sync.sh）
