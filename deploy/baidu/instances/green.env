# 绿实例（stronghold@green.service）的端口。蓝实例是 stronghold.service 里的 PORT=3000。
# 两个实例共用 /opt/stronghold 与 data/，只有监听端口不同（都只绑 loopback，对外统一走 nginx）。
PORT=3001

# 上游 0.4.0 起大厅默认版本是规程；玩法插件未声明 versions 只进 act2 —— 与蓝实例（stronghold.service）
# 的 SP_VERSION_DEFAULT 保持一致（2026-11-15 升级定），否则蓝绿切到绿侧后插件房翻默认版本。
SP_VERSION_DEFAULT=act2autochess
