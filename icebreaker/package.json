{
  "name": "icebreaker-games",
  "version": "0.0.0",
  "private": true,
  "description": "促融共竞：基于明日方舟通用引擎的双人实时合作玩法平台。非官方同人项目。",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@11.28.0",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"packages/*/test/**/*.test.js\"",
    "e2e": "node --test \"test/e2e/**/*.e2e.js\"",
    "coverage": "aue-check coverage",
    "check": "aue-check",
    "ci": "pnpm run lint && pnpm run typecheck && pnpm run coverage && pnpm run check"
  },
  "devDependencies": {
    "@aue/lint": "workspace:*",
    "@aue/testkit": "workspace:*",
    "@icebreaker/server": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.18.0",
    "eslint": "^10.11.0",
    "fast-check": "^4.10.2",
    "globals": "^17.12.0",
    "playwright": "1.63.0",
    "typescript": "6.0.3"
  }
}
