{
  // JavaScript with JSDoc types, checked strictly, as in the engine. Nothing is emitted.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "target": "es2023",
    "lib": ["es2023", "dom", "dom.iterable"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["packages/*/src/**/*.js", "packages/*/test/**/*.js", "test/e2e/**/*.js", "eslint.config.js"],
  "exclude": ["**/node_modules", "engine"]
}
