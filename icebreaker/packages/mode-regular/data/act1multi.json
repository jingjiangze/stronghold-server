    {
     "cmd": "Battle.Pause",
     "args": {
      "pause": false
     }
    },
    {
     "cmd": "Delay",
     "args": {
      "time": 9.2
     }
    },
    {
     "cmd": "Battle.Pause",
     "args": {
      "pause": true
     }
    },
    {
     "cmd": "Tutorial",
     "args": {
      "focusX": 55,
